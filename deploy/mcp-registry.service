[Unit]
Description=MCP Registry (Phoenix release)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=exec
User=mcp_registry
Group=mcp_registry
WorkingDirectory=/opt/mcp-registry/current
EnvironmentFile=/etc/mcp-registry.env
ExecStartPre=/opt/mcp-registry/current/bin/migrate
ExecStart=/opt/mcp-registry/current/bin/server
Restart=on-failure
RestartSec=5
# The box is shared with other sites, so the registry gets a ceiling. It is a
# guard rail, not a squeeze: siblings run at 512M-768M and two are uncapped.
#
# Raised from 300M/400M on 2026-09-24. The old numbers were sized for a 1 GB
# host that has since been upgraded to 12 GB, and left roughly 87 MB of
# headroom -- enough that loading the geo-IP database pushed the BEAM through
# MemoryHigh into MemoryMax and stalled every database-backed request while
# routes touching no database kept answering.
#
# Raised again the same day. 768M was still too tight: with the geo database
# resident the working set settles near 700 MB, and memory.events recorded
# tens of thousands of `high` breaches -- the kernel reclaiming hard, which is
# the same stall in miniature. Read that file before trusting a ceiling here:
#
#   cat /sys/fs/cgroup/system.slice/mcp-registry.service/memory.events
#
# `high` should stay at or near zero. It is the early warning that `max` and
# an outage are next.
MemoryHigh=2G
MemoryMax=3G
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
