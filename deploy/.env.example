# Copy to deploy/.env and fill in. Never commit deploy/.env.
PHX_HOST=ai.mcpharbor.dev

# Loopback port the release listens on behind nginx. Must be free on the server.
APP_PORT=4610

# openssl rand -hex 24   (hex only: it is embedded in a database URL)
POSTGRES_PASSWORD=

# mix phx.gen.secret
SECRET_KEY_BASE=

# Required to boot at all in prod -- ask the project owner for the key
# rather than generating your own; it must match the hash baked into
# config/runtime.exs.
MCP_REGISTRY_LICENSE_KEY=

# openssl rand -hex 32   (bearer token for POST /api/v0/servers; blank disables API publishing)
REGISTRY_PUBLISH_TOKEN=

# Seriously Simple Analytics account ID. Blank disables analytics *silently* --
# the site works exactly as before and simply records nothing, which is easy to
# miss. One id drives both halves: the browser tag in the root layout and the
# server-side plug in the endpoint, which is what sees the agents and crawlers
# the tag cannot.
#
# Get one with:
#   curl -X POST https://seriouslysimpleanalytics.com/api/v1/accounts -d project=mcp-registry
# The response carries `uid` (this value) and `claim_url`, a one-time sign-in
# link that is the only way into the dashboard -- keep it.
#
# Left blank here, deploy.sh carries forward whatever the host already has
# rather than blanking it.
SSA_ACCOUNT_ID=
SSA_PROJECT=mcp-registry
